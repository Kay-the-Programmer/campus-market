# --- Required ------------------------------------------------------------
# Postgres password. docker-compose.yml refuses to start without it rather
# than falling back to a guessable default, so it is required even locally.
# Use something real on the VPS; anything works on your own machine.
POSTGRES_PASSWORD="campusmarket"

# The domain Caddy fetches a TLS certificate for, e.g. campusmarket.example.com
# Bare domain, no scheme.
#
# Only for the all-in-one deployment, where this repo's own Caddy serves both
# the SPA and the API. The current production setup is NOT that: the frontend
# is on Vercel and the API sits behind the SalePilot stack's Caddy, which is
# the only container on that VM publishing 80/443. docker-compose.prod.yml has
# the details. Leave this blank there - nothing reads it.
SITE_ADDRESS=""

APP_URL="MY_APP_URL"

# --- Frontend -> API ------------------------------------------------------
# Where the browser should send API requests. Read at BUILD time by Vite, so
# it must be set wherever the frontend is built - for the Vercel deployment
# that means Vercel's own Project Settings -> Environment Variables, not this
# file, and a redeploy is required for a change to take effect.
#
# Leave blank for the all-in-one deployment: requests then go to /api on
# whatever origin served the app, which is the same Caddy that proxies them.
VITE_API_BASE_URL="https://campusmarket.example.com"

# --- Deployment / CORS & Admin Settings ------------------------------------
# Which browser origins may call this API (comma-separated). This is where the
# FRONTEND is served from - not this API's own domain, which is a common way
# to get an allowlist that looks populated and still rejects every request.
# E.g. "https://myfrontend.vercel.app,https://www.myfrontend.com"
#
# Blank falls back to the defaults in AppProperties. Safe to leave blank only
# for the all-in-one deployment, where the app and API share an origin and no
# CORS check is involved at all.
CAMPUSMARKET_CORS_ORIGINS=""

# Demo users and demo listings, seeded only into an empty database. Local
# convenience; never for a live site. docker-compose.prod.yml hardcodes this to
# false and ignores whatever is set here.
#
# Turning it off does NOT remove demo rows that were already seeded on an
# earlier boot - it only stops new ones. Clearing existing ones is a database
# operation; see "Starting from a clean database" in the README.
CAMPUSMARKET_SEED_DEMO_DATA="false"

# --- Administrator account ------------------------------------------------
# Reconciled against these values on every boot: created if the email is not
# present yet, and kept in step with the name afterwards. Categories are also
# created automatically; nothing else is.
CAMPUSMARKET_ADMIN_EMAIL="admin@campus.edu"
CAMPUSMARKET_ADMIN_NAME="Campus Marketplace Admin"

# Required in production - docker-compose.prod.yml refuses to start without it.
# There is deliberately no fallback: the one that used to exist is in this
# repository's git history, and an administrator account on a public site is
# the last place for a published password. Use something real.
CAMPUSMARKET_ADMIN_PASSWORD=""

# Changing CAMPUSMARKET_ADMIN_PASSWORD above does nothing on its own once the
# account exists - otherwise every restart would silently undo a password the
# administrator had changed in the app. Set this to "true" for exactly one
# restart to apply a new password, then set it back to "false".
CAMPUSMARKET_ADMIN_PASSWORD_RESET="false"


# --- Email (optional) ----------------------------------------------------
# Powers two things: email alongside in-app notifications (an order moved, a
# new message), and admin-composed campaigns sent from the console.
#
# Leave SPRING_MAIL_HOST unset and no mail is sent - every message is written
# to the container log instead, which is what a local run wants. Campaigns
# refuse to send rather than reporting success, so nothing silently vanishes.
#
# Any provider that speaks SMTP works - Brevo, Mailgun, SendGrid, Amazon SES,
# Resend, Postmark. Nothing in the code names one, so switching is a change
# here and nowhere else. 587 with STARTTLS is the usual submission port; use
# 465 only for a provider that wants implicit TLS.
SPRING_MAIL_HOST=""
SPRING_MAIL_PORT="587"
SPRING_MAIL_USERNAME=""
SPRING_MAIL_PASSWORD=""

# The envelope sender. This has to be an address on a domain the provider has
# verified, with SPF and DKIM published for it. Without those, bulk mail to
# Gmail or Outlook is junked or refused outright - and the symptom is "the
# email never arrived", with nothing in any log to explain it.
CAMPUSMARKET_MAIL_FROM=""
CAMPUSMARKET_MAIL_FROM_NAME="CampusMarket"

# Public URL of the frontend, absolute and with no trailing slash. It becomes
# the unsubscribe link and every deep link in an email, so localhost here
# produces mail whose links work for nobody but you. Campaigns will not send
# without it, because a campaign with a broken unsubscribe link earns spam
# complaints instead of unsubscribes.
CAMPUSMARKET_APP_BASE_URL="https://campus-market-mu.vercel.app"

# Campaign pacing: recipients per batch, and the pause between batches. Shared
# SMTP providers rate-limit per connection and answer a burst with temporary
# failures that are indistinguishable from bad addresses.
CAMPUSMARKET_MAIL_BATCH_SIZE="25"
CAMPUSMARKET_MAIL_BATCH_PAUSE_MILLIS="1000"

# --- "Continue with Google" (REQUIRED) ---------------------------------
# Not optional any more. Google is the only way to sign in - the email and
# password forms were removed so that creating an account never needs an email
# verification code - so a build without these values has no working login at
# all. The modal says as much rather than rendering an empty panel, but it is
# still a locked door. This comment used to call them optional and describe
# "every other auth flow"; there are no other auth flows.
#
# All five are read at BUILD time by Vite and inlined into the bundle, so on
# Vercel they belong in Project Settings -> Environment Variables, and a change
# needs a redeploy to take effect. None of them is a secret: every one ships in
# the JavaScript any visitor can read. Access is controlled by Firebase Auth
# and by the backend verifying the ID token, not by keeping these hidden.
#
# 1. https://console.firebase.google.com -> Add project (or reuse one).
# 2. Authentication -> Sign-in method -> enable "Google".
# 3. Authentication -> Settings -> Authorized domains -> add the domain the
#    app is served from (e.g. campus-market-mu.vercel.app). Without this the
#    popup closes with auth/unauthorized-domain and logs nothing useful.
#    localhost is authorized by default, which is why local dev works first try.
# 4. Project settings -> General -> Your apps -> Web app -> copy these values:
VITE_FIREBASE_API_KEY=""
# Firebase hosts the OAuth handler the popup redirects through, so sign-in
# fails at runtime without this - and it fails *after* the button renders,
# because the button only checks that the api key and project id are present.
# A half-filled config is worse than an empty one: it looks like it works.
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
# Web Push only, and only alongside the VAPID key below. Missing either, the
# app keeps in-app notifications and hides the push opt-in - sign-in is
# unaffected. Project settings -> Cloud Messaging.
VITE_FIREBASE_MESSAGING_SENDER_ID=""
# Project settings -> Cloud Messaging -> Web configuration -> Web Push
# certificates -> "Key pair". Public by design, like the rest of these.
VITE_FIREBASE_VAPID_KEY=""

# 4. Project settings -> Service accounts -> Generate new private key.
#    Paste the downloaded JSON file's contents as ONE line below, then set it
#    as CAMPUSMARKET_FIREBASE_CREDENTIALS_JSON in the environment docker
#    compose reads from (e.g. a root .env file docker compose loads
#    automatically) - NOT this Vite file, and never commit the real value.
#    This is what lets the backend verify Google ID tokens.
# CAMPUSMARKET_FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...", ...}

# --- Listing/promo image storage (optional) -----------------------------
# Leave these unset and uploaded images are written to local disk instead
# (see the campusmarket-uploads volume in docker-compose.yml) - everything
# else works unchanged.
#
# 1. Cloud Console -> Cloud Storage -> Buckets -> Create.
# 2. That bucket -> Permissions -> Grant access -> principal "allUsers",
#    role "Storage Object Viewer" - served image URLs are plain
#    https://storage.googleapis.com/... links, so they need to be publicly
#    readable the same way any CDN asset is.
# 3. A service account with "Storage Object Admin" on that bucket - can be
#    the same key used for CAMPUSMARKET_FIREBASE_CREDENTIALS_JSON above if
#    that service account is also granted this role.
# CAMPUSMARKET_GCS_BUCKET=my-campusmarket-images
# CAMPUSMARKET_GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...", ...}
